[Unit]
Description=Ki-67 Inference Server (FastAPI + OpenVINO)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__/deployment/openvino
ExecStart=__UVICORN_BIN__ server:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
