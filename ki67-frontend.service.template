[Unit]
Description=Ki-67 Frontend (Next.js)
After=network.target ki67-inference.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__/frontend/.next/standalone
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
ExecStart=__NODE_BIN__ server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
